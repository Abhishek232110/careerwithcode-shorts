  {
   "title": [{"text": "defer +", "box": "yellow"}, {"text": "recover"}],
   "image": {"type": "code", "file": "main.go", "lines": [
     "func safeDivide(a, b int) (res int, err error) {",
     "  defer func() {",
     "    if r := recover(); r != nil {",
     "      err = fmt.Errorf(\"recovered: %v\", r)",
     "    }",
     "  }()",
     "  return a / b, nil",
     "}"
   ], "highlight": [2, 3]},
   "face": "thinking",
   "palette": "blue",
   "say": "To catch a panic, put recover inside a deferred function. If something panics, recover grabs it, and we turn it into a normal error."
  },
  {
   "title": [{"text": "Still", "box": "yellow"}, {"text": "running!"}],
   "image": {"type": "code", "file": "main.go", "lines": [
     "fmt.Println(safeDivide(10, 2))",
     "fmt.Println(safeDivide(10, 0))",
     "fmt.Println(\"still running\")"
   ], "highlight": [1], "output": [
     "5 <nil>",
     "0 recovered: runtime error:",
     "  integer divide by zero",
     "still running"
