    {"heading": "Start a server",
     "code": [
       "func hello(w http.ResponseWriter,",
       "           r *http.Request) {",
       "  fmt.Fprintln(w, \"Hello, Go!\")",
       "}",
       "http.HandleFunc(\"/\", hello)",
       "http.ListenAndServe(\":8080\", nil)"
     ]},
    {"heading": "Send JSON",
     "code": [
       "type User struct {",
       "  ID   int    `json:\"id\"`",
       "  Name string `json:\"name\"`",
       "}",
       "u := User{1, \"Gopher\"}",
       "json.NewEncoder(w).Encode(u)",
       "// {\"id\":1,\"name\":\"Gopher\"}"
     ]},
    {"heading": "Routes + params", "tag": "Go 1.22+",
